# Django Environment Settings
DEBUG=True
SECRET_KEY=your-secure-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite if omitted)
# DATABASE_URL=postgres://user:password@localhost:5432/ecommerce_db

# CORS Origin for Next.js Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cambodia Localization
KHR_EXCHANGE_RATE=4100
DEFAULT_TAX_RATE=0.10

# National Bank of Cambodia (NBC) Bakong KHQR Settings
BAKONG_ACCOUNT_ID=your_merchant_account@abaa   # or phone@wing / bakong id
BAKONG_MERCHANT_NAME=Clothes Apparel Co
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/
BAKONG_API_TOKEN=your-nbc-bakong-api-token
